---
# Pinned to the schema for the installed Talos release.
# yaml-language-server: $schema=https://raw.githubusercontent.com/siderolabs/talos/v1.14.3/pkg/machinery/config/schemas/config.schema.json
# Legacy document: only holds what has no dedicated config document yet
# (trust material, tokens, hostDNS, disk quota, etcd).
version: v1alpha1
machine:
  ca:
    crt: '{{ ENV.MACHINE_CA_CRT }}'
    {% if ENV.IS_CONTROLLER %}
    key: '{{ ENV.MACHINE_CA_KEY }}'
    {% endif %}

  features:
    diskQuotaSupport: true

  token: '{{ ENV.MACHINE_TOKEN }}'

cluster:
  ca:
    crt: '{{ ENV.CLUSTER_CA_CRT }}'
    {% if ENV.IS_CONTROLLER %}
    key: '{{ ENV.CLUSTER_CA_KEY }}'
    {% endif %}

  # clusterName + controlPlane.endpoint stay here on purpose: moving them to
  # KubeClusterConfig forces serviceAccount into KubeServiceAccountConfig,
  # which expects raw PEM while Vault stores base64.
  clusterName: k8s

  controlPlane:
    endpoint: https://k8s.internal:6443

  token: '{{ ENV.CLUSTER_TOKEN }}'

  {% if ENV.IS_CONTROLLER %}
  aggregatorCA:
    crt: '{{ ENV.CLUSTER_AGGREGATOR_CA_CRT }}'
    key: '{{ ENV.CLUSTER_AGGREGATOR_CA_KEY }}'

  etcd:
    advertisedSubnets:
      - 192.168.90.0/24
    ca:
      crt: '{{ ENV.CLUSTER_ETCD_CA_CRT }}'
      key: '{{ ENV.CLUSTER_ETCD_CA_KEY }}'
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381

      # do not wake up CPU so often
      heartbeat-interval: "500"
      election-timeout: "5000"

  serviceAccount:
    key: '{{ ENV.CLUSTER_SERVICE_ACCOUNT_KEY }}'
  {% endif %}

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: factory.talos.dev/metal-installer-secureboot/6eb006416f53f5416578d5d7d8ada36980e55836a38017f1c52bb97072726b68:v1.14.4
# provisioning (disk selector, wipe) is per node, see nodes/

---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nbd

---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: thunderbolt

---
apiVersion: v1alpha1
kind: SysctlConfig
params:
  # Filesystem Watchers
  fs.inotify.max_user_instances: "8192" # Talos v1.13 default
  fs.inotify.max_user_watches: "1048576" # More inotify events

  # Virtual Memory Tuning
  vm.nr_hugepages: "1024" # PostgreSQL

  # Network Performance Tuning
  net.core.default_qdisc: fq # Enable pacing and fair queueing for smoother flow control
  net.core.rmem_max: "67108864" # Cloudflared / QUIC
  net.core.wmem_max: "67108864" # Cloudflared / QUIC
  net.ipv4.neigh.default.gc_thresh1: "4096" # ARP neighbor GC thresholds
  net.ipv4.neigh.default.gc_thresh2: "8192" # ARP neighbor GC thresholds
  net.ipv4.neigh.default.gc_thresh3: "16384" # ARP neighbor GC thresholds
  net.ipv4.ping_group_range: "0 2147483647" # allow unprivileged PINGs
  net.ipv4.tcp_congestion_control: bbr # Use BBR congestion control for fast, low-latency delivery
  net.ipv4.tcp_fastopen: "3" # Send and accept data in the opening SYN packet
  net.ipv4.tcp_mtu_probing: "1" # Enable MTU probing in case of ICMP blackholes
  net.ipv4.tcp_slow_start_after_idle: "0" # Handle traffic bursts better
  net.ipv4.tcp_window_scaling: "1" # Enable TCP window scaling to go beyond 64KB receive windows
  # net.ipv4.tcp_rmem: 4096 87380 8388608  # Conservative receive buffer tuning (min, default, max in bytes)
  # net.ipv4.tcp_wmem: 4096 65536 8388608  # Conservative send buffer tuning (min, default, max in bytes)
  net.ipv4.tcp_rmem: 4096 87380 33554432 # Performant receive buffer tuning (min, default, max in bytes)
  net.ipv4.tcp_wmem: 4096 65536 33554432 # Performant send buffer tuning (min, default, max in bytes)

  # NFS Client Tuning
  sunrpc.tcp_max_slot_table_entries: "128" # Faster NFS
  sunrpc.tcp_slot_table_entries: "128" # Faster NFS

  # Process & Namespace Limits
  user.max_user_namespaces: "11255" # User Namespaces

---
apiVersion: v1alpha1
kind: SysfsConfig
params:
  devices.system.cpu.intel_pstate.hwp_dynamic_boost: "1"

---
apiVersion: v1alpha1
kind: UdevRulesConfig
rules:
  # Intel GPU
  - SUBSYSTEM=="drm", KERNEL=="renderD*", GROUP="44", MODE="0660"

---
# NFS
apiVersion: v1alpha1
kind: EtcFileConfig
name: nfsmount.conf
mode: 0o644
contents: |
  [ NFSMount_Global_Options ]
  nfsvers=4.2
  hard=True
  nconnect=8
  noatime=True
  rsize=1048576
  wsize=1048576

# ---------------------------------------------------------------------------
# CRI
# ---------------------------------------------------------------------------
---
# Spegel (discard_unpacked_layers) + GPU device ownership
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: 20-customization
content: |
  [plugins."io.containerd.cri.v1.images"]
    discard_unpacked_layers = false
  [plugins."io.containerd.cri.v1.runtime"]
    device_ownership_from_security_context = true

# ---------------------------------------------------------------------------
# Block
# ---------------------------------------------------------------------------
---
# weekly xfs_scrub of STATE/EPHEMERAL
apiVersion: v1alpha1
kind: FilesystemScrubConfig
interval: 168h0m0s

---
# weekly fstrim of the system NVMe
apiVersion: v1alpha1
kind: FilesystemTrimConfig
interval: 168h0m0s

# ---------------------------------------------------------------------------
# Cluster discovery
# ---------------------------------------------------------------------------
---
apiVersion: v1alpha1
kind: DiscoveryIdentityConfig
clusterID: '{{ ENV.CLUSTER_ID }}'
clusterSecret: '{{ ENV.CLUSTER_SECRET }}'

---
apiVersion: v1alpha1
kind: DiscoveryServiceConfig
name: primary
endpoint: https://discovery.talos.dev/

# ---------------------------------------------------------------------------
# Kubernetes (all nodes)
# ---------------------------------------------------------------------------
---
apiVersion: v1alpha1
kind: KubePrismConfig
port: 7445

---
apiVersion: v1alpha1
kind: KubeNetworkConfig
podSubnets:
  - 10.42.0.0/16
serviceSubnets:
  - 10.43.0.0/16

---
apiVersion: v1alpha1
kind: KubeletConfig
image: ghcr.io/siderolabs/kubelet:v1.37.1
defaultRuntimeSeccompProfileEnabled: true
config:
  crashLoopBackOff:
    maxContainerRestartPeriod: 60s
  featureGates:
    UserNamespacesSupport: true # Kubernetes v1.36 GA/default; retained as an explicit assertion
  imageGCHighThresholdPercent: 65
  imageGCLowThresholdPercent: 50
  imageMaximumGCAge: 168h
  maxParallelImagePulls: 3
  maxPods: 150
  serializeImagePulls: false
  shutdownGracePeriod: 120s
  shutdownGracePeriodCriticalPods: 60s

---
# no taints listed = control planes are schedulable
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - 192.168.90.0/24
labels:
  node-role.kubernetes.io/control-plane: "" # not auto-added with KubeNodeConfig
  node.kubernetes.io/gpu: "true"
  topology.kubernetes.io/region: gensokyo
  # topology.kubernetes.io/zone is per node, see nodes/

{% if ENV.IS_CONTROLLER %}
# ---------------------------------------------------------------------------
# Kubernetes (control plane only)
# ---------------------------------------------------------------------------
---
apiVersion: v1alpha1
kind: KubeTalosAPIAccessConfig
allowedRoles:
  - os:admin
allowedKubernetesNamespaces:
  - system-upgrade

---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
image: registry.k8s.io/kube-apiserver:v1.37.1
certExtraSANs:
  - k8s.internal
extraArgs:
  enable-aggregator-routing: "true" # mandatory without kube-proxy
  feature-gates: HPAScaleToZero=true

---
# With KubeAPIServerConfig, Talos no longer injects the default authorizers
# or the anonymous-auth flag; these documents restore the previous behaviour.
# Anonymous access is limited to the health endpoints the liveness probe uses.
apiVersion: v1alpha1
kind: KubeAuthenticationConfig
configuration:
  anonymous:
    enabled: true
    conditions:
      - path: /livez
      - path: /readyz
      - path: /healthz
  jwt: []

---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: node
type: Node

---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: rbac
type: RBAC

---
apiVersion: v1alpha1
kind: KubeAdmissionControlConfig
name: PodSecurity
configuration:
  apiVersion: pod-security.admission.config.k8s.io/v1alpha1
  kind: PodSecurityConfiguration
  defaults:
    audit: restricted
    audit-version: latest
    enforce: baseline
    enforce-version: latest
    warn: restricted
    warn-version: latest
  exemptions:
    namespaces:
      - kube-system
    runtimeClasses: []
    usernames: []

---
apiVersion: v1alpha1
kind: KubeAuditPolicyConfig
configuration:
  apiVersion: audit.k8s.io/v1
  kind: Policy
  rules:
    - level: Metadata

---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
image: registry.k8s.io/kube-controller-manager:v1.37.1
extraArgs:
  bind-address: 0.0.0.0
  feature-gates: HPAScaleToZero=true

---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
image: registry.k8s.io/kube-scheduler:v1.37.1
config:
  profiles:
    - schedulerName: default-scheduler
      plugins:
        score:
          disabled:
            - name: ImageLocality
      pluginConfig:
        - name: PodTopologySpread
          args:
            defaultingType: List
            defaultConstraints:
              - maxSkew: 1
                topologyKey: kubernetes.io/hostname
                whenUnsatisfiable: ScheduleAnyway
extraArgs:
  bind-address: 0.0.0.0

---
# Cilium replaces both
apiVersion: v1alpha1
kind: KubeCoreDNSConfig
enabled: false

---
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false
image: registry.k8s.io/kube-proxy:v1.37.1

---
# identical to what Talos generated from .cluster.secretboxEncryptionSecret
apiVersion: v1alpha1
kind: KubeEtcdEncryptionConfig
config:
  resources:
    - resources:
        - secrets
      providers:
        - secretbox:
            keys:
              - name: key2
                secret: '{{ ENV.CLUSTER_SECRETBOX_ENCRYPTION_SECRET }}'
        - identity: {}
{% endif %}

# ---------------------------------------------------------------------------
# System services / volumes / network
# ---------------------------------------------------------------------------
---
apiVersion: v1alpha1
kind: TimeSyncConfig
ntp:
  servers:
    - time.cloudflare.com

---
apiVersion: v1alpha1
kind: ResolverConfig
hostDNS:
  enabled: true
  forwardKubeDNSToHost: true # requires Cilium socketLB features
  resolveMemberNames: true
nameservers:
  - address: 192.168.90.1 # UDM-P gateway on homelab VLAN - prefer local over internet
  - address: 1.1.1.1

---
apiVersion: v1alpha1
kind: VolumeConfig
name: STATE
encryption:
  provider: luks2
  keys:
    - slot: 0
      tpm: {}

---
apiVersion: v1alpha1
kind: VolumeConfig
name: EPHEMERAL
encryption:
  provider: luks2
  keys:
    - slot: 0
      tpm: {}

---
apiVersion: v1alpha1
kind: ImageVerificationConfig
rules:
  - image: registry.k8s.io/*
    keyless:
      issuer: https://accounts.google.com
      subject: krel-trust@k8s-releng-prod.iam.gserviceaccount.com
  - image: ghcr.io/siderolabs/*
    keyless:
      issuer: https://accounts.google.com
      subjectRegex: '(@siderolabs\.com$|^releasemgr-svc@talos-production\.iam\.gserviceaccount\.com$)'
  - image: factory.talos.dev/*
    keyless:
      issuer: https://accounts.google.com
      subject: image-factory-signing@talos-production.iam.gserviceaccount.com

---
apiVersion: v1alpha1
kind: LinkConfig
name: eth0
mtu: 1500
addresses: []

---
apiVersion: v1alpha1
kind: DHCPv4Config
name: eth0

---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: 192.168.90.5
link: eth0

---
apiVersion: v1alpha1
kind: VLANConfig
name: eth0.30
vlanID: 30
parent: eth0
mtu: 1500

---
apiVersion: v1alpha1
kind: WatchdogTimerConfig
device: /dev/watchdog0
timeout: 5m
